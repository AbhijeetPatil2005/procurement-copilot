# ---- Local mock service ------------------------------------------------------
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
# VENDOR_RISK_TIMEOUT_S=3.0
# VENDOR_RISK_RETRIES=1

# ---- LLM provider ------------------------------------------------------------
# Auto-detected from whichever key is set (Anthropic preferred). With no key the
# app still runs: both architectures degrade to the deterministic policy result.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama, YepAPI, ...)
# OPENAI_AUTH_HEADER=         # set to x-api-key for gateways that reject Bearer auth (e.g. YepAPI)
#
# Google Gemini free tier example (OpenAI-compatible endpoint):
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_API_KEY=<key from https://aistudio.google.com/apikey>
#   MODEL_NAME=gemini-3.6-flash
#   LLM_MIN_INTERVAL_S=6        # stay under free-tier requests-per-minute
# LLM_MIN_INTERVAL_S=0        # client-side spacing between LLM requests (seconds)
# LLM_RATE_LIMIT_RETRIES=3    # backoff retries on 429/5xx; waits are excluded from reported latency
# LLM_PROVIDER=anthropic      # anthropic | openai | none (force)

# Model + effort. Defaults: claude-opus-5-5 (anthropic) / gpt-4o-mini (openai).
# MODEL_NAME=claude-opus-5-5
# LLM_EFFORT=medium           # low | medium | high (Claude 4.6+ models)
# LLM_TIMEOUT_S=120
# MAX_AGENT_TURNS=10
# ANTHROPIC_FALLBACKS=default # server-side refusal fallback; set to off to disable
